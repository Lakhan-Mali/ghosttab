# ---------------------------------------------------------------------------
# GhostTab AI — environment template
# Copy to .env and edit. Never commit a real .env.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=dev-insecure-key-change-me-in-production-9f3a2c7e8b1d4a6f
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI provider — "demo" requires no key and produces deterministic output.
# Set to "openai" or "zai" to call a real LLM.
AI_PROVIDER=demo
AI_API_KEY=
AI_API_BASE=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1200
AI_MAX_PAGES_PER_REQUEST=30
AI_MAX_CONTENT_CHARS_PER_PAGE=4000
AI_RATE_LIMIT_PER_HOUR=60

# Optional: shared token for browser extension authentication.
# Leave empty to use Django session cookies only.
GHOSTTAB_EXTENSION_TOKEN=

# Optional: enable the SSRF-defended URL metadata fetcher (off by default).
# When enabled, the backend will fetch only the title and favicon for newly
# added URLs, with strict private-IP filtering, redirect caps, and size limits.
GTAB_FETCH_METADATA=0

# Email (dev: console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=GhostTab AI <noreply@ghosttab.local>
SUPPORT_EMAIL=support@ghosttab.local
