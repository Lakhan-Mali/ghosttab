{
  "manifest_version": 3,
  "name": "GhostTab AI",
  "version": "1.0.0",
  "description": "Send selected browser tabs to your GhostTab AI workspace and pick up where your mind left off.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GhostTab AI — save tabs"
  },
  "permissions": ["tabs", "storage", "activeTab"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
